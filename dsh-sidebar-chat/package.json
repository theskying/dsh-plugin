{
  "name": "@local/dsh-sidebar-chat",
  "version": "0.1.0",
  "private": true,
  "engines": { "dsh": "0.2.1-rc.2" },
  "type": "module",
  "description": "OpenAI Codex-inspired side conversations for DSH, with independent model and permission selection, main-conversation context references, and a 12-hour lifetime.",
  "homepage": "https://github.com/theskying/dsh-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theskying/dsh-plugin.git",
    "directory": "dsh-sidebar-chat"
  },
  "bugs": { "url": "https://github.com/theskying/dsh-plugin/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "lifecycle.js", "context.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "dependencies": { "zod": "4.4.3" },
  "scripts": { "test": "node --test tests/*.test.mjs" }
}
